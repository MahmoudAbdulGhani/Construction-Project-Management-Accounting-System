# Django development settings. Generate a unique value; do not reuse this placeholder.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Supabase PostgreSQL connection details from the Supabase Connect dialog.
# Use either the direct connection or session pooler values supported by your network.
DB_NAME=postgres
DB_USER=replace-with-supabase-database-user
DB_PASSWORD=replace-with-supabase-database-password
DB_HOST=replace-with-supabase-database-host
DB_PORT=5432
DB_SSLMODE=require

# SMTP email settings (used by the auth password-reset email flow).
# For local testing only, set EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# to print emails to the console instead of sending them.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=replace-with-smtp-host
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-with-smtp-username
EMAIL_HOST_PASSWORD=replace-with-smtp-password
DEFAULT_FROM_EMAIL=Your Company <no-reply@example.com>

# Base URL of the frontend password-reset page (the reset link appends ?uid=...&token=...).
PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password
# Password-reset token validity in seconds (default 259200 = 3 days).
PASSWORD_RESET_TIMEOUT=259200

# Supabase Storage (company logo upload on the Company settings page, plus
# uploaded documents on the Documents page).
# SUPABASE_URL is https://<project-ref>.supabase.co ; SUPABASE_SERVICE_ROLE_KEY
# is the "service_role (secret)" key from Project Settings -> API and is
# preferred for uploads (it bypasses Storage RLS, so no public INSERT policy
# is needed). SUPABASE_ANON_KEY is the "anon public" key and is only used as a
# fallback when no service role key is set. Logo *display* needs none of these.
# When these are set, documents are stored in the SUPABASE_DOCUMENTS_BUCKET
# bucket (created automatically on first upload); leave SUPABASE_DOCUMENT_STORAGE
# unset/empty to keep document uploads on local disk instead.
SUPABASE_URL=replace-with-https-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_LOGO_BUCKET=logo
SUPABASE_DOCUMENTS_BUCKET=documents

